{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "SVBLIME-web-optimizado/**",
              "components/content/**",
              "components/core/**",
              "deck-stage.js",
              "ui_kits/casi-ultimo-elvis/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Borscha|Hanken Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Borscha, Hanken Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|mono|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, mono, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|amber|violet|neutral|outline)$/]",
        "message": "<Badge> tone must be one of 'blue' | 'amber' | 'violet' | 'neutral' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|signal|disabled|iconLeft|iconRight|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, signal, disabled, iconLeft, iconRight, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|signal)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'signal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='signal'] > Literal[value!=/^(?:blue|amber|violet)$/]",
        "message": "<Button> signal must be one of 'blue' | 'amber' | 'violet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|interactive|accent|padding|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, interactive, accent, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:blue|amber|violet)$/]",
        "message": "<Card> accent must be one of 'blue' | 'amber' | 'violet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tick|tickColor|color|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, tick, tickColor, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FounderCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|disciplines|accent|photo|hoverPhotos|grayscale|initials|style|key|ref|className|style|children)$/]",
        "message": "<FounderCard> doesn't accept that prop. Declared props: name, role, disciplines, accent, photo, hoverPhotos, grayscale, initials, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FounderCard'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:blue|amber|violet)$/]",
        "message": "<FounderCard> accent must be one of 'blue' | 'amber' | 'violet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillarCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|description|accent|icon|style|key|ref|className|style|children)$/]",
        "message": "<PillarCard> doesn't accept that prop. Declared props: number, title, description, accent, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillarCard'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:blue|amber|violet|white)$/]",
        "message": "<PillarCard> accent must be one of 'blue' | 'amber' | 'violet' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|cite|size|align|style|key|ref|className|style|children)$/]",
        "message": "<QuoteBlock> doesn't accept that prop. Declared props: children, cite, size, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg|xl)$/]",
        "message": "<QuoteBlock> size must be one of 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<QuoteBlock> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpectrumBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:thickness|length|orientation|radius|style|key|ref|className|style|children)$/]",
        "message": "<SpectrumBar> doesn't accept that prop. Declared props: thickness, length, orientation, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpectrumBar'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<SpectrumBar> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|accent|align|style|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: value, label, accent, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:blue|amber|violet|white)$/]",
        "message": "<StatBlock> accent must be one of 'blue' | 'amber' | 'violet' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<StatBlock> align must be one of 'left' | 'center'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
